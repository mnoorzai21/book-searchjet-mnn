# Copy to server/.env for local development. Never commit .env.

# Local MongoDB, or your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/googlebooks

# Any long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: free Google Books API key. Without one, searches share Google's
# anonymous limit and can fail with "busy" errors.
GOOGLE_BOOKS_API_KEY=
